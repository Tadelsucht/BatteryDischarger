<!-- Keep the interface light across host theme settings; the app exposes no theme switch. -->
<Application
    x:Class="BatteryDischarger.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
